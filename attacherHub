			if state.activePresetIdx and state.presets[state.activePresetIdx] then setStatus("🔄 Preset-Re-Attach: " .. p.DisplayName, rgb(220, 60, 70)) startPreset(state.presets[state.activePresetIdx], p)
			else setStatus("🔄 Re-Attach: " .. p.DisplayName, rgb(220, 60, 70)) startWeld(state.pendingMode or "attach", p) end
