	local function createPlayerCard(p)
		if p == LP then return end
		local card = mkBtn({Name = p.Name, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = rgb(22, 22, 28), Text = "", Parent = PlayerListFrame, _corner = 10})
		stroke(card, rgb(38, 38, 48), 1)
		local av = mk("ImageLabel", {Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(0, 6, 0.5, -12), BackgroundColor3 = rgb(22, 22, 28), BorderSizePixel = 0, Parent = card})
		corner(av, 1)
		task.spawn(function()
			pcall(function() av.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48) end)
		end)
		mkLabel({Size = UDim2.new(1, -60, 0, 16), Position = UDim2.new(0, 36, 0, 3), Text = p.DisplayName, TextColor3 = rgb(235, 235, 240), TextSize = 12, Font = Enum.Font.GothamSemibold, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card})
		mkLabel({Size = UDim2.new(1, -60, 0, 13), Position = UDim2.new(0, 36, 0, 19), Text = "@" .. p.Name, TextColor3 = rgb(80, 80, 85), TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card})
		local d2 = mk("Frame", {Size = UDim2.new(0, 8, 0, 8), Position = UDim2.new(1, -14, 0.5, -4), BackgroundColor3 = rgb(38, 38, 48), BorderSizePixel = 0, Parent = card})
		corner(d2, 1)
		hoverTween(card, "BackgroundColor3", rgb(22, 22, 28), rgb(22, 22, 28))
		card.MouseButton1Click:Connect(function() selectPlayerUI(p) end)
		ui.playerBtns[p.Name] = {card = card, dot = d2, player = p}
		if state.selPlayer == p or (state.trackedName and state.trackedName == p.Name) then
			tweenProp(card, 0.1, {BackgroundColor3 = rgb(40, 16, 20)})
			tweenProp(d2, 0.1, {BackgroundColor3 = rgb(220, 40, 50)})
		end
	end

	refreshPlayerList = function(filter)
		for _, c in ipairs(PlayerListFrame:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		ui.playerBtns = {}
		filter = (filter or ""):lower()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP then
				if filter == "" or p.Name:lower():find(filter, 1, true) or p.DisplayName:lower():find(filter, 1, true) then
					createPlayerCard(p)
				end
			end
		end
	end
	refreshPlayerList()
	SearchBox:GetPropertyChangedSignal("Text"):Connect(function() refreshPlayerList(SearchBox.Text) end)

	resolveLockedTarget = function()
		if not state.trackedName then return nil end
		local p = Players:FindFirstChild(state.trackedName)
		if p and p:IsA("Player") and p ~= LP then return p end
		return nil
	end

	resolveTarget = function()
		if state.targetMode == "specific" then
			if state.selPlayer and state.selPlayer.Parent == Players then return state.selPlayer end
			if state.trackedName then
				local p = Players:FindFirstChild(state.trackedName)
				if p and p:IsA("Player") and p ~= LP then state.selPlayer = p return p end
			end
			return nil
		elseif state.targetMode == "nearest" then return findNearest()
		elseif state.targetMode == "random" then
			local pool = {}
			for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then table.insert(pool, p) end end
			if #pool > 0 then return pool[math.random(#pool)] end
			return nil
		end
	end
end

