	local searchGen = 0
	local function buildVariants(kw, cursor)
		local kwP = (kw and kw ~= "") and ("&Keyword=" .. HttpService:UrlEncode(kw)) or ""
		local curP = (cursor and cursor ~= "") and ("&Cursor=" .. HttpService:UrlEncode(cursor)) or ""
		return {
			"Limit=30&SortType=0&Category=12&AssetTypes=61" .. kwP .. curP,
			"Limit=30&SortType=0&Category=12" .. kwP .. curP,
			"Limit=30&SortType=0&AssetTypes=61" .. kwP .. curP,
			"Limit=30&SortType=0&Category=1&Subcategory=12&AssetTypes=61" .. kwP .. curP,
		}
	end

	local function doEmoteSearch(kw, append)
		if append and state.emote.loading then return end
		if not append then
			searchGen = searchGen + 1
			for _, c in ipairs(EScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
			state.emote.searchItems, state.emote.cursor = {}, ""
			EScroll.CanvasPosition = Vector2.new(0, 0)
		end
		local myGen = searchGen
		state.emote.loading = true
		EStatus.Text, EStatus.TextColor3 = "Suche...", rgb(220, 40, 50)
		task.spawn(function()
			local variants = buildVariants(kw, append and state.emote.cursor or "")
			local endpoints = {
				"https://catalog.roproxy.com/v1/search/items/details?",
				"https://catalog.roblox.com/v1/search/items/details?",
				"https://catalog.roproxy.com/v1/search/items?",
				"https://catalog.roblox.com/v1/search/items?",
			}
			local data = nil
			local tried = 0
			for _, p in ipairs(variants) do
				for _, base in ipairs(endpoints) do
					if myGen ~= searchGen then return end
					tried = tried + 1
					if tried > 1 then task.wait(0.15) end
					local ok, d = pcall(function() return httpGet(base .. p) end)
					if ok and d and type(d) == "table" and d.data and type(d.data) == "table" and #d.data > 0 then
						data = d
						break
					end
				end
				if data then break end
			end
			if myGen ~= searchGen then return end
			if not data or not data.data or #data.data == 0 then
				if not append then EStatus.Text, EStatus.TextColor3 = "Keine Emotes gefunden", rgb(200, 150, 50) end
				if myGen == searchGen then state.emote.loading = false end
				return
			end
			state.emote.cursor = data.nextPageCursor or ""
			local nameMap = {}
			local function isEmoteItem(it)
				local at = it.assetType or it.AssetType
