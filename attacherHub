local function ensureFolder()
	if isfolder and not isfolder(PRESET_FOLDER) then makefolder(PRESET_FOLDER) end
end
local function saveFile(name, data)
	pcall(function()
		ensureFolder()
		writefile(PRESET_FOLDER .. "/" .. name, HttpService:JSONEncode(data))
	end)
end
local function loadFile(name)
	local r
	pcall(function()
		ensureFolder()
		if isfile and isfile(PRESET_FOLDER .. "/" .. name) then
			r = HttpService:JSONDecode(readfile(PRESET_FOLDER .. "/" .. name))
		end
	end)
	return r
end
local function savePresets()
	saveFile("presets.json", {__version = 2, presets = state.presets, folders = state.folders})
end
local function getFolderIndex(name)
	for i, f in ipairs(state.folders) do
		if f.name == name then return i end
	end
end
local function ensureFolderExists(name)
	if not name or name == "" then return end
	if not getFolderIndex(name) then
		table.insert(state.folders, {name = name, collapsed = false})
	end
end
local function saveKeybinds()
	local d = {}
	for _, kb in ipairs(state.keybinds) do
		table.insert(d, {presetIndex = kb.presetIndex, keyName = kb.keyName, holdMode = kb.holdMode})
	end
	saveFile("keybinds.json", d)
end
local function saveSpeedSwitch()
	saveFile("speedswitch.json", {
		enabled = state.speedSwitch.enabled,
		threshold = state.speedSwitch.threshold,
		fastIdx = state.speedSwitch.fastIdx,
		basePresetIdx = state.speedSwitch.basePresetIdx,
	})
end
local function saveUIConfig()
	saveFile("uiconfig.json", {uiHotkey = state.uiHotkey, uiPosition = state.uiPosition})
end
local function loadUIConfig()
	local d = loadFile("uiconfig.json")
	if not d then return end
	if d.uiHotkey then state.uiHotkey = d.uiHotkey end
	if d.uiPosition then state.uiPosition = d.uiPosition end
