	stopEmote = function()
		if state.emote.track then
			pcall(function() state.emote.track:Stop() end)
			pcall(function() state.emote.track:Destroy() end)
			state.emote.track = nil
		end
		state.emote.playing = false
		state.emote.paused = false
		ECurLbl.Text = "Kein Emote aktiv"
		ECurLbl.TextColor3 = rgb(85, 85, 90)
	end

	playEmote = function(id, name, overrideSpeed)
		local spd = overrideSpeed or state.emote.speed
		if spd == 0 then spd = 1 end
		state.emote.speed = spd
		SpeedBox.Text = tostring(spd)
		stopEmote()
		local ch = getC(LP)
		if not ch then setStatus("⚠ Kein Charakter!", rgb(240, 70, 80)) return end
		local h = ch:FindFirstChildOfClass("Humanoid")
		if not h then return end
		local animator = h:FindFirstChildOfClass("Animator") or Instance.new("Animator", h)
		state.emote.id = id
		state.emote.name = isValidName(name) and name or nil
		task.spawn(function()
			local track
			local ok, obj = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
			if ok and obj and #obj > 0 then
				for _, o in ipairs(obj) do
					local a = o:IsA("Animation") and o or o:FindFirstChildOfClass("Animation", true)
					if a then
						local s, t = pcall(function() return animator:LoadAnimation(a) end)
						if s then track = t end
						break
					end
				end
			end
			if not track then
				local a = Instance.new("Animation")
				a.AnimationId = "rbxassetid://" .. id
				local s, t = pcall(function() return animator:LoadAnimation(a) end)
				if s then track = t end
			end
			if not track then setStatus("⚠ Animation fehlgeschlagen!", rgb(240, 70, 80)) return end
			state.emote.track = track
			track.Priority = Enum.AnimationPriority.Action4
			track.Looped = true
			pcall(function() track:AdjustWeight(10) end)
			track:AdjustSpeed(spd)
			track:Play()
			state.emote.playing = true
			state.emote.paused = false
			ECurLbl.Text = "▶ " .. (state.emote.name or "Emote") .. " (Speed: " .. spd .. ")"
			ECurLbl.TextColor3 = rgb(220, 60, 70)
			setStatus("Emote: " .. (state.emote.name or "Emote") .. " | Speed: " .. spd, rgb(220, 60, 70))
		end)
	end

	pauseEmote = function()
		if not state.emote.track then return end
		local nm = state.emote.name or "Emote"
		if state.emote.paused then
