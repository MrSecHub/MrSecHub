local function setCollisions(on)
	if not getC(LP) then return end
	for _, p in ipairs(getC(LP):GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = on
			if not on then
				p.Massless = true
				p.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
				for _, c in ipairs(p:GetChildren()) do
					if c:IsA("BodyMover") then c:Destroy() end
				end
			else
				p.Massless = false
				p.CustomPhysicalProperties = nil
			end
		end
	end
end

local function httpReq(opts)
	local ok, r = pcall(function()
		if syn and syn.request then return syn.request(opts)
		elseif request then return request(opts)
		elseif http_request then return http_request(opts)
		elseif opts.Method == "GET" and game.HttpGet then return {Body = game:HttpGet(opts.Url)} end
	end)
	if not ok or not r then return nil end
	local b = r.Body or r.body
	if not b then return nil end
	local s, d = pcall(HttpService.JSONDecode, HttpService, b)
	return s and d
end
local function httpGet(url) return httpReq({Url = url, Method = "GET"}) end

local nameCache, nameFetching, nameCallbacks = {}, {}, {}

local function isValidName(s)
	if type(s) ~= "string" then return false end
	if #s == 0 then return false end
	if s:lower() == "nil" then return false end
	if s:lower() == "[content deleted]" then return false end
	if s == "?" then return false end
	return true
end

local function trySingleFetch(id)
	local attempts = {
		"https://economy.roblox.com/v2/assets/" .. id .. "/details",
		"https://economy.roproxy.com/v2/assets/" .. id .. "/details",
		"https://catalog.roblox.com/v1/catalog/items/" .. id .. "/details?itemType=Asset",
		"https://catalog.roproxy.com/v1/catalog/items/" .. id .. "/details?itemType=Asset",
		"https://api.roblox.com/marketplace/productinfo?assetId=" .. id,
	}
	for _, url in ipairs(attempts) do
		local ok, d = pcall(function() return httpGet(url) end)
		if ok and d then
			local nm = d.Name or d.name
			if isValidName(nm) then return nm end
		end
	end
	return nil
end

local function tryBatchFetch(ids)
	local res = {}
	if #ids == 0 then return res end
	local batch = {}
	for _, id in ipairs(ids) do table.insert(batch, {itemType = "Asset", id = id}) end
	local body = HttpService:JSONEncode({items = batch})
	for _, url in ipairs({"https://catalog.roblox.com/v1/catalog/items/details", "https://catalog.roproxy.com/v1/catalog/items/details"}) do
		local ok, d = pcall(function()
			return httpReq({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
		end)
		if ok and d and d.data and #d.data > 0 then
			for _, it in ipairs(d.data) do
				local iid, nm = it.id or it.Id, it.name or it.Name
				if iid and isValidName(nm) then res[iid] = nm end
			end
			if next(res) then return res end
		end
	end
	return res
end

local function requestName(id, callback)
	if not id then if callback then callback(nil) end return end
	id = tostring(id)
	if nameCache[id] then
		if callback then task.spawn(function() callback(nameCache[id]) end) end
		return
	end
	if callback then
		nameCallbacks[id] = nameCallbacks[id] or {}
		table.insert(nameCallbacks[id], callback)
	end
	if nameFetching[id] then return end
	nameFetching[id] = true
	task.spawn(function()
		local nm = trySingleFetch(id)
		if not nm then task.wait(0.4) nm = trySingleFetch(id) end
		nameFetching[id] = nil
		if nm then nameCache[id] = nm end
		local cbs = nameCallbacks[id]
		nameCallbacks[id] = nil
		if cbs then for _, cb in ipairs(cbs) do pcall(cb, nm) end end
	end)
end

local function requestNames(ids)
	local pending, seen = {}, {}
	for _, id in ipairs(ids) do
		id = tostring(id)
		if id and not nameCache[id] and not nameFetching[id] and not seen[id] then
			seen[id] = true
			table.insert(pending, id)
		end
	end
	if #pending == 0 then return end
	for _, id in ipairs(pending) do nameFetching[id] = true end
	task.spawn(function()
		local res = tryBatchFetch(pending)
		local missing = {}
		for _, id in ipairs(pending) do
			if res[id] then nameCache[id] = res[id] else table.insert(missing, id) end
		end
		local i = 1
		while i <= #missing do
			local group = {}
			for j = i, math.min(i + 2, #missing) do table.insert(group, missing[j]) end
			local threads = {}
			for _, id in ipairs(group) do
				table.insert(threads, task.spawn(function()
					local nm = trySingleFetch(id)
					if nm then nameCache[id] = nm end
				end))
			end
			for _, th in ipairs(threads) do pcall(task.wait, th) end
			i = i + 3
		end
		for _, id in ipairs(pending) do
			nameFetching[id] = nil
			local cbs = nameCallbacks[id]
			nameCallbacks[id] = nil
			if cbs then for _, cb in ipairs(cbs) do pcall(cb, nameCache[id]) end end
		end
	end)
end

local function findNearest()
	local h = getHRP(LP)
	if not h then return end
	local best, bestD = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local hr = getHRP(p)
			if hr then
				local d = (hr.Position - h.Position).Magnitude
				if d < bestD then bestD = d best = p end
			end
		end
	end
	return best
end

