	return row
end

local function makeNumInput(par, y, label, def, step, onChange)
	local row = mk("Frame", {Size = UDim2.new(1, -16, 0, 30), Position = UDim2.new(0, 8, 0, y), BackgroundTransparency = 1, Parent = par})
	mkLabel({Size = UDim2.new(0.40, 0, 1, 0), Text = label, TextColor3 = C.dim, TextSize = 11, Parent = row})
	local cur = def
	local box = mk("TextBox", {
		Size = UDim2.new(0, 54, 0, 24), Position = UDim2.new(0.42, 28, 0.5, -12),
		BackgroundColor3 = C.card, BorderSizePixel = 0, Text = tostring(def),
		TextColor3 = C.red, TextSize = 12, Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = true, Parent = row,
		_corner = 7, _stroke = C.line,
	})
	local function setV(v) cur = v box.Text = fmtN(v) onChange(v) end
	for _, d in ipairs({{pos = UDim2.new(0.42, 0, 0.5, -12), txt = "−", off = -step}, {pos = UDim2.new(0.42, 86, 0.5, -12), txt = "+", off = step}}) do
		local b = mkBtn({Size = UDim2.new(0, 24, 0, 24), Position = d.pos, BackgroundColor3 = C.card, Text = d.txt, TextColor3 = C.text, TextSize = 13, Parent = row, _corner = 7})
		stroke(b, C.line, 1)
		hoverTween(b, "BackgroundColor3", rgb(34, 34, 42), C.card)
		b.MouseButton1Click:Connect(function() setV(cur + d.off) end)
	end
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then setV(n) else box.Text = fmtN(cur) end
	end)
	return setV
end

local function makeSlider(par, y, label, minV, maxV, def, step, onChange)
	local row = mk("Frame", {Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0, 8, 0, y), BackgroundTransparency = 1, Parent = par})
	mkLabel({Size = UDim2.new(1, -56, 0, 16), Text = label, TextColor3 = C.dim, TextSize = 11, Parent = row})
	local box = mk("TextBox", {
		Size = UDim2.new(0, 46, 0, 18), Position = UDim2.new(1, -46, 0, -1),
		BackgroundColor3 = C.card, BorderSizePixel = 0, Text = tostring(def),
		TextColor3 = C.red, TextSize = 11, Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = true, Parent = row,
		_corner = 6, _stroke = C.line,
	})
	local track = mk("Frame", {Size = UDim2.new(1, 0, 0, 5), Position = UDim2.new(0, 0, 0, 26), BackgroundColor3 = C.card, BorderSizePixel = 0, Parent = row})
	corner(track, 1)
	local r0 = math.clamp((def - minV) / (maxV - minV), 0, 1)
	local fill = mk("Frame", {Size = UDim2.new(r0, 0, 1, 0), BackgroundColor3 = C.red, BorderSizePixel = 0, Parent = track})
	corner(fill, 1)
	local knob = mk("Frame", {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(r0, -6, 0.5, -6), BackgroundColor3 = C.text, BorderSizePixel = 0, ZIndex = 4, Parent = track})
	corner(knob, 1)
	local dz = mkBtn({Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Text = "", ZIndex = 3, Parent = row})
	local cur, sd = def, false
	local function roundTo(v, s) if s == 0 then return math.floor(v + 0.5) end return math.floor(v / s + 0.5) * s end
	local function setV(v)
		v = math.clamp(roundTo(v, step), minV, maxV)
		cur = v
		box.Text = tostring(roundTo(v, step))
		local r2 = (v - minV) / (maxV - minV)
		fill.Size = UDim2.new(r2, 0, 1, 0)
		knob.Position = UDim2.new(r2, -6, 0.5, -6)
		onChange(v)
	end
	local function pos2v(sx)
		local ab, sz = track.AbsolutePosition, track.AbsoluteSize
		return minV + (maxV - minV) * math.clamp((sx - ab.X) / sz.X, 0, 1)
	end
	dz.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then sd = true setV(pos2v(i.Position.X)) end
	end)
	UIS.InputChanged:Connect(function(i)
		if sd and i.UserInputType == Enum.UserInputType.MouseMovement then setV(pos2v(i.Position.X)) end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then sd = false end
	end)
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then setV(n) else box.Text = tostring(cur) end
	end)
	return setV
end

