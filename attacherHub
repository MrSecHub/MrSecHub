local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local function fmtN(n)
	if n == math.floor(n) then return tostring(math.floor(n)) end
	return string.format("%.1f", n)
end
local function corner(p, r)
	local c = Instance.new("UICorner", p)
	-- Immer Pixel-Offset (nie Scale) — Scale würde große Frames zu Eiern machen
	if r == nil then
		c.CornerRadius = UDim.new(0, 8)
	elseif type(r) == "number" then
		-- Werte >= 1 = Pixel-Radius; 0 = keine Rundung
		c.CornerRadius = UDim.new(0, math.max(0, math.floor(r)))
	else
		c.CornerRadius = UDim.new(0, 8)
	end
	return c
end
local function stroke(p, col, th)
	local s = Instance.new("UIStroke", p)
	s.Color = col or rgb(38, 38, 48)
	s.Thickness = th or 1
	return s
end
local function padding(p, t, b, l, r)
	local u = Instance.new("UIPadding", p)
	u.PaddingTop = UDim.new(0, t or 0)
	u.PaddingBottom = UDim.new(0, b or t or 0)
	u.PaddingLeft = UDim.new(0, l or 0)
	u.PaddingRight = UDim.new(0, r or l or 0)
	return u
end
local function listLayout(p, pad, sort)
	local l = Instance.new("UIListLayout", p)
	l.Padding = UDim.new(0, pad or 3)
	l.SortOrder = sort or Enum.SortOrder.LayoutOrder
	return l
end
local function mk(class, props)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		if k == "Parent" then continue end
		if k == "_corner" then corner(obj, v)
		elseif k == "_stroke" then stroke(obj, v)
		else pcall(function() obj[k] = v end) end
	end
	if props.Parent then obj.Parent = props.Parent end
	return obj
end
