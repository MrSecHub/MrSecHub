UIS.InputBegan:Connect(function(inp, gpe)
	if gpe or kbListening or uiListening then return end
	if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local kn = inp.KeyCode.Name
	if kn == state.uiHotkey then toggleUI() return end
	for _, kb in ipairs(state.keybinds) do
		if kb.keyName == kn then
			if kb.holdMode then
				if not kb.active then kb.active = true heldKeys[kn] = true execKBPreset(kb) updateKBAllDots() end
			else
				if kb.active then kb.active = false stopKBPreset() state.activePresetIdx = nil if rebuildPresetList then pcall(rebuildPresetList) end updateKBAllDots()
				else for _, kb2 in ipairs(state.keybinds) do if kb2.active and kb2 ~= kb then kb2.active = false end end kb.active = true execKBPreset(kb) updateKBAllDots() end
			end
			break
		end
	end
end)
UIS.InputEnded:Connect(function(inp)
	if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local kn = inp.KeyCode.Name
	heldKeys[kn] = nil
	for _, kb in ipairs(state.keybinds) do
		if kb.keyName == kn and kb.holdMode and kb.active then kb.active = false stopKBPreset() updateKBAllDots() break end
	end
end)

