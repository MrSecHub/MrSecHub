stopWeld = function(keep)
	if state.conn then pcall(function() state.conn:Disconnect() end) state.conn = nil end
	local ch = getC(LP)
	if ch then
		local hrp = ch:FindFirstChild("HumanoidRootPart")
		if hrp then
			setPhysicsRep(hrp, nil)
			pcall(function() hrp.Velocity = Vector3.zero hrp.AssemblyLinearVelocity = Vector3.zero hrp.AssemblyAngularVelocity = Vector3.zero end)
			for _, n in ipairs({"BodyVelocity", "BodyAngularVelocity", "BodyPosition", "BodyGyro"}) do local o = hrp:FindFirstChild(n) if o then o:Destroy() end end
		end
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = true p.Massless = false p.Anchored = false p.CustomPhysicalProperties = nil end
		end
		local h = ch:FindFirstChildOfClass("Humanoid")
		if h then
			h.PlatformStand = false h.Sit = false h.AutoRotate = true
			pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
			task.defer(function() if not state.weldActive then pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end) end end)
		end
	end
	resetCameraSubject()
	if not keep then
		state.weldActive = false state.pendingMode = nil state.mode = nil state.target = nil
		state.kf.playing = false state.kf.idx = 1 state.kf.timer = 0
		for _, d in pairs(ui.modeBtns) do tweenProp(d.stroke, 0.12, {Color = rgb(22, 22, 22)}) tweenProp(d.lbl, 0.12, {TextColor3 = rgb(150, 150, 155)}) end
		setStatus("Idle", rgb(80, 200, 80))
	else setStatus("Warte auf Charakter...", rgb(240, 180, 50)) end
end

local function placeOnGround()
	local ch = getC(LP)
	if not ch then return end
	local hrp = ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local h = ch:FindFirstChildOfClass("Humanoid")
	pcall(function() setPhysicsRep(hrp, nil) end)
	hrp.Anchored = false
	for _, p in ipairs(ch:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = false p.CanCollide = true p.Velocity = Vector3.zero p.RotVelocity = Vector3.zero
			p.AssemblyLinearVelocity = Vector3.zero p.AssemblyAngularVelocity = Vector3.zero p.Massless = false p.CustomPhysicalProperties = nil
		end
	end
	if h then h.PlatformStand = false h.Sit = false h.AutoRotate = true pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
	pcall(function() hrp:SetNetworkOwner(LP) end)
	pcall(function() hrp:SetNetworkOwnershipAuto(true) end)
	local result = workspace:Raycast(hrp.Position + Vector3.new(0, 8, 0), Vector3.new(0, -500, 0), RaycastParams.new())
	local standY = result and (result.Position.Y + (hrp.Size.Y / 2) + 0.1) or (hrp.Position.Y + 5)
	hrp.CFrame = CFrame.new(hrp.Position.X, standY, hrp.Position.Z) * hrp.CFrame.Rotation
	if h then
		task.wait(0.05) pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		task.wait(0.03) pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
		if h.Health <= 0 then pcall(function() h.Health = h.MaxHealth end) end
	end
end

local function execWeld(mId, tgt)
	local myH = getHRP(LP) local h = getHum(LP)
	if not myH or not h then return false end
	state.origPlat = h.PlatformStand h.PlatformStand = true h.Sit = false h.AutoRotate = false
	pcall(function() h:ChangeState(Enum.HumanoidStateType.Physics) end)
	setCollisions(false)
	if ui.modeBtns[mId] then
		tweenProp(ui.modeBtns[mId].stroke, 0.15, {Color = ui.modeBtns[mId].data.color})
		tweenProp(ui.modeBtns[mId].lbl, 0.15, {TextColor3 = ui.modeBtns[mId].data.color})
	end
	state.trackedName = tgt.Name
	setStatus("Attach → " .. tgt.DisplayName .. " [" .. state.bodyPart .. "]", rgb(220, 60, 70))
	applyViewTarget()
	if state.conn then pcall(function() state.conn:Disconnect() end) state.conn = nil end
	local myHrp = myH local kfTimer, kfIdx = 0, 1 local viewCounter = 0
	local function getTargetPart() local tc = tgt.Character if not tc then return nil end return tc:FindFirstChild(state.bodyPart) or tc:FindFirstChild("HumanoidRootPart") end
	local function makeOffset()
		local c = state.cfg.attach
		return CFrame.new(c.right, c.up, -c.forward) * CFrame.fromEulerAnglesXYZ(math.rad(c.rotX), math.rad(c.rotY), math.rad(c.rotZ))
	end
	local initPart = getTargetPart()
	if initPart then setPhysicsRep(myHrp, initPart) myHrp.CFrame = initPart.CFrame * makeOffset() pcall(function() myHrp.Velocity = Vector3.zero end) end

	-- Speed-Switch Reset beim Weld-Start
	do
		local ss = state.speedSwitch
		ss.smoothedVel = 0
		ss.aboveSince = 0
		ss.belowSince = 0
		ss.graceUntil = tick() + 0.5
		ss.modeEnteredAt = tick()
	end

	state.conn = RunService.Heartbeat:Connect(function(dt)
		if not state.weldActive then return end
		if not myHrp or not myHrp.Parent then myHrp = getHRP(LP) if not myHrp then return end end
		local hum = getHum(LP)
		if hum then
			if not hum.PlatformStand then hum.PlatformStand = true end
			if hum.Sit then hum.Sit = false end
			if hum.AutoRotate then hum.AutoRotate = false end
			local hs = hum:GetState()
			if hs ~= Enum.HumanoidStateType.Physics and hs ~= Enum.HumanoidStateType.Dead and hs ~= Enum.HumanoidStateType.GettingUp then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end) end
		end
		local hisHrp = getTargetPart()
		if not hisHrp then return end
		setPhysicsRep(myHrp, hisHrp) pcall(function() myHrp.Velocity = Vector3.zero end)
		viewCounter = viewCounter + 1
		if viewCounter % 60 == 0 then setCollisions(false) end
		if state.viewTarget and viewCounter % 30 == 0 then applyViewTarget() end
		local offset = makeOffset()
		if state.kf.playing and #state.kf.frames >= 2 then
			kfTimer = kfTimer + dt local a = math.clamp(kfTimer / state.kf.speed, 0, 1) local ni = (kfIdx % #state.kf.frames) + 1
			local function kfC(i)
				local kf = state.kf.frames[i] if not kf then return offset end
				return CFrame.new(kf.right, kf.up, -kf.forward) * CFrame.fromEulerAnglesXYZ(math.rad(kf.rotX), math.rad(kf.rotY), math.rad(kf.rotZ))
			end
			offset = kfC(kfIdx):Lerp(kfC(ni), a)
			if kfTimer >= state.kf.speed then kfTimer = 0 kfIdx = ni end
		else kfTimer = 0 kfIdx = 1 end
		myHrp.CFrame = hisHrp.CFrame * offset

		-- ══════ AUTO-SPEED-SWITCH (moderat träge) ══════
		local ss = state.speedSwitch
		if ss.enabled and ss.fastIdx and ss.basePresetIdx then
			if not state.presets[ss.fastIdx] then ss.fastIdx = nil saveSpeedSwitch() end
			if not state.presets[ss.basePresetIdx] then ss.basePresetIdx = nil saveSpeedSwitch() end

			if ss.fastIdx and ss.basePresetIdx then
				local now = tick()

				local vel = hisHrp.AssemblyLinearVelocity
				if vel.Magnitude < 0.01 then
					vel = hisHrp.Velocity or vel
				end
				local horiz = Vector3.new(vel.X, 0, vel.Z).Magnitude

				if horiz < 1 then
					local tHum = tgt.Character and tgt.Character:FindFirstChildOfClass("Humanoid")
					if tHum then
						local wv = tHum.MoveDirection * tHum.WalkSpeed
						horiz = Vector3.new(wv.X, 0, wv.Z).Magnitude
					end
				end

				local dtc = math.min(dt or 0, 0.1)
				local alpha = 1 - math.exp(-dtc * (ss.smoothingHz or 8))
				ss.smoothedVel = ss.smoothedVel + (horiz - ss.smoothedVel) * alpha

				local thr = ss.threshold
				local hiThr = thr * (ss.fastHysteresis or 1.10)   -- normal → fast: 110 %
				local loThr = thr * (ss.hysteresis or 0.65)       -- fast  → normal: 65 %

				if ss.smoothedVel >= hiThr then
					if ss.aboveSince == 0 then ss.aboveSince = now end
					ss.belowSince = 0
				elseif ss.smoothedVel <= loThr then
					if ss.belowSince == 0 then ss.belowSince = now end
					ss.aboveSince = 0
				else
					ss.aboveSince = 0
					ss.belowSince = 0
				end

				local aboveReady = ss.aboveSince > 0 and (now - ss.aboveSince) >= (ss.requiredTimeFast or 0.8)
				local belowReady = ss.belowSince > 0 and (now - ss.belowSince) >= (ss.requiredTimeNormal or 1.2)

				local modeTimeOk = (now - (ss.modeEnteredAt or 0)) >= (ss.minModeTime or 1.5)

				local canSwitch =
					modeTimeOk and
					now >= (ss.manualOverrideUntil or 0) and
					now >= (ss.graceUntil or 0) and
					(now - ss.lastSwitch) >= (ss.cooldown or 1.4)

				if canSwitch then
					if ss.mode == "normal" and aboveReady then
						local p = state.presets[ss.fastIdx]
						if p then
							ss.mode = "fast"
							ss.lastSwitch = now
							ss.modeEnteredAt = now
							ss.graceUntil = now + 0.5
							ss.aboveSince = 0
							ss.belowSince = 0
							applyPresetConfigSmart(p)
							setStatus(string.format("⚡ Fast (%.0f)", ss.smoothedVel), rgb(240, 180, 50))
							if updateSSLabels then updateSSLabels() end
						end
					elseif ss.mode == "fast" and belowReady then
						local p = state.presets[ss.basePresetIdx]
						if p then
							ss.mode = "normal"
							ss.lastSwitch = now
							ss.modeEnteredAt = now
							ss.graceUntil = now + 0.5
							ss.aboveSince = 0
							ss.belowSince = 0
							applyPresetConfigSmart(p)
							setStatus(string.format("🐢 Base (%.0f)", ss.smoothedVel), rgb(220, 60, 70))
							if updateSSLabels then updateSSLabels() end
						end
					end
				end
			end
		end
		-- ══════ /AUTO-SPEED-SWITCH ══════
	end)
	return true
end

startWeld = function(mId, forcedTarget)
	if not forcedTarget and state.awaitingReattach then
		state.awaitingReattach = false
		if state.reattachToken then pcall(task.cancel, state.reattachToken) end
		state.reattachToken = nil
	end
	local t = forcedTarget or resolveTarget()
	if not t then setStatus("⚠ Kein Ziel!", rgb(240, 70, 80)) return end
	stopWeld(true) state.weldActive = true state.pendingMode = mId state.mode = mId state.target = t state.trackedName = t.Name
	if not execWeld(mId, t) then setStatus("⚠ Charakter nicht bereit", rgb(240, 180, 50)) end
end

stopAll = function()
	if state.awaitingReattach then
		state.awaitingReattach = false
		if state.reattachToken then pcall(task.cancel, state.reattachToken) end
		state.reattachToken = nil
	end
	state.activePresetIdx = nil stopWeld(false)
	state.kf.playing = false state.kf.idx = 1 state.kf.timer = 0
	if syncPlayBtns then syncPlayBtns() end
	if stopEmote then stopEmote() end
	for _, kb in ipairs(state.keybinds) do kb.active = false end
	if updateKBAllDots then updateKBAllDots() end
	if rebuildPresetList then pcall(rebuildPresetList) end
	state.weldActive = false state.pendingMode = nil state.mode = nil state.target = nil state.trackedName = nil state.selPlayer = nil state.origPlat = false
	resetCameraSubject() state.viewTarget = true
	if updateViewBtn then updateViewBtn() end
	setStatus("⏹ Stop — lande auf dem Boden...", rgb(240, 180, 50)) placeOnGround()
	if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then
		local h = LP.Character:FindFirstChildOfClass("Humanoid")
		h.PlatformStand = false h.Sit = false h.AutoRotate = true
		pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
	end
	task.delay(0.8, function() setStatus("⏹ Alles gestoppt — Idle", rgb(140, 140, 145)) end)
end

