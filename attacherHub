			state.kf.timer = 0
		end

		if p.kfSpeed and p.kfSpeed ~= state.kf.speed then
			state.kf.speed = p.kfSpeed
		end

		if state.emote.id ~= p.emoteId then
			if p.emoteId then
				playEmote(p.emoteId, p.emoteName, p.emoteSpeed or 1)
			else
				stopEmote()
				state.emote.id = nil
				state.emote.name = nil
			end
		elseif p.emoteId and state.emote.track then
			local spd = p.emoteSpeed or 1
			if spd ~= state.emote.speed then
				state.emote.speed = spd
				if SpeedBox then SpeedBox.Text = tostring(spd) end
				pcall(function() state.emote.track:AdjustSpeed(spd) end)
			end
		end
	end

	startPreset = function(p, forcedTarget)
		loadPreset(p)
		local t = forcedTarget or resolveTarget()
		if not t then setStatus("⚠ Kein Ziel für Preset \"" .. (p.name or "?") .. "\"!", rgb(240, 70, 80)) return end
		state.target = t state.trackedName = t.Name
		if state.speedSwitch.enabled then
			local idx = table.find(state.presets, p)
			if idx then
				local ss = state.speedSwitch
				ss.smoothedVel = 0
				ss.aboveSince = 0
				ss.belowSince = 0
				ss.graceUntil = tick() + 0.6
				ss.modeEnteredAt = tick()
				if idx == ss.fastIdx then
					ss.mode = "fast"
				else
					ss.mode = "normal"
					ss.basePresetIdx = idx
					ss.manualOverrideUntil = tick() + 1.0
				end
			end
			if updateSSLabels then updateSSLabels() end
		end
		startWeld("attach", t)
		if p.emoteId then task.defer(function() local spd = p.emoteSpeed or 1 if spd == 0 then spd = 1 end playEmote(p.emoteId, p.emoteName, spd) end) end
		setStatus("▶ \"" .. (p.name or "?") .. "\" gestartet → " .. t.DisplayName, rgb(220, 60, 70))
	end

