end)

Players.PlayerRemoving:Connect(function(p)
	if state.selPlayer == p then state.selPlayer = nil end
	task.wait(0.1) refreshPlayerList(SearchBox.Text)
	if p ~= state.target or not state.weldActive then return end
	local savedMode, savedName, savedDisplay = state.pendingMode, p.Name, p.DisplayName
	setStatus("⚠ " .. savedDisplay .. " hat den Server verlassen", rgb(240, 180, 50))
	if state.conn then state.conn:Disconnect() state.conn = nil end
	local hrp = getHRP(LP)
	if hrp then setPhysicsRep(hrp, nil) hrp.Anchored = false hrp.CanCollide = true pcall(function() hrp:SetNetworkOwnershipAuto(true) end) end
	local h = getHum(LP)
	if h then h.PlatformStand = false h.Sit = false h.AutoRotate = true pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end) pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end) end
	setCollisions(true) resetCameraSubject() if stopEmote then stopEmote() end
	state.weldActive = false state.pendingMode = savedMode state.trackedName = savedName state.target = nil state.awaitingReattach = true
	if state.reattachToken then pcall(task.cancel, state.reattachToken) end
	local token = {} state.reattachToken = token
	task.spawn(function()
		for i = 60, 1, -1 do
			task.wait(1)
			if state.reattachToken ~= token then return end
			if not state.awaitingReattach then return end
			if i % 5 == 0 or i <= 5 then setStatus("⏳ Warte " .. i .. "s auf " .. savedDisplay .. "...", rgb(240, 180, 50)) end
		end
		if state.reattachToken == token then
			state.awaitingReattach = false state.reattachToken = nil state.pendingMode = nil state.trackedName = nil
			setStatus("⏱ Zeit abgelaufen — " .. savedDisplay .. " kam nicht zurück", rgb(200, 120, 60))
		end
	end)
end)

LP.CharacterAdded:Connect(function(ch)
	if state.weldActive and state.pendingMode then
		task.spawn(function()
			local h = ch:WaitForChild("Humanoid", 6) if not h then return end
			ch:WaitForChild("HumanoidRootPart", 6) task.wait(0.5)
			if not state.weldActive then return end
			local lockedT = resolveLockedTarget()
			if not lockedT then setStatus("⚠ Respawn: Ziel weg", rgb(240, 180, 50)) return end
			state.target = lockedT
			if state.activePresetIdx and state.presets[state.activePresetIdx] then setStatus("🔄 Ich bin respawnt — Preset startet neu", rgb(220, 60, 70)) startPreset(state.presets[state.activePresetIdx], lockedT)
			else startWeld(state.pendingMode, lockedT) end
		end)
		return
	end
	if state.emote.playing and state.emote.id and not state.emote.paused then
		task.spawn(function()
			local h = ch:WaitForChild("Humanoid", 6) if not h then return end
			task.wait(0.5)
			if state.emote.id and state.emote.playing then playEmote(state.emote.id, state.emote.name, state.emote.speed) end
		end)
	end
end)

